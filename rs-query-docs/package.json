{
  "name": "rs-query-docs",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Documentation site for rs-query — TanStack Query v5 parity for Rust, built with Astro Starlight.",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm og:compile && node scripts/generate-llms.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "markdownlint-cli2 \"src/content/docs/**/*.mdx\"",
    "qa": "node scripts/qa-screenshots.mjs",
    "qa:search": "node scripts/qa-search-check.mjs",
    "og:compile": "./node_modules/.bin/esbuild src/og-render.jsx --loader:.jsx=jsx --jsx=automatic --format=esm --outfile=src/og-render.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/roboto": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#c4b8331abb1dc2f157d62fba634eeb17f5e689cd",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
